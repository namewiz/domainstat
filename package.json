{
  "name": "domainstat",
  "version": "1.5.0",
  "description": "Extremely fast domain status checker library using DoH, RDAP and WHOIS API.",
  "type": "module",
  "main": "./dist/index.js",
  "browser": "./dist/index.browser.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "npm run build:lib && npm run build:lib:browser && npm run build:cli",
    "build:lib": "npx -y esbuild src/index.ts --bundle --minify --format=esm --target=es2020 --outdir=dist/ --platform=neutral --external:epp-client && tsc --emitDeclarationOnly",
    "build:lib:browser": "node scripts/build-browser.mjs",
    "build:cli": "npx -y esbuild src/cli.ts --bundle --minify --format=esm --target=node20 --outfile=dist/cli.js --platform=node",
    "test": "npm run build && node --test",
    "test:serial": "SERIAL=true npm run build && node --test",
    "start": "npm run build && npx serve docs"
  },
  "homepage": "https://namewiz.github.io/domainstat",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/namewiz/domainstat.git"
  },
  "bugs": {
    "url": "https://github.com/namewiz/domainstat/issues"
  },
  "author": "Justice Ogbonna <dev@justiceo.com>",
  "keywords": [
    "domain-name",
    "domain-status",
    "domain-availability",
    "rdap",
    "whois"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/index.browser.js",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "domainstat": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "dependencies": {
    "tldts": "^7.0.30"
  },
  "optionalDependencies": {
    "epp-client": "^0.4.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "esbuild": "^0.28.2",
    "typescript": "5.6"
  }
}
